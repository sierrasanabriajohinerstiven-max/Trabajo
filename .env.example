# Copiar este archivo a ".env" y completar los valores reales.
# ".env" NO se sube al repositorio (ver .gitignore).

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-segura

# Ruta de la base de datos SQLite local (relativa a la carpeta instance/)
DATABASE_URL=sqlite:///instance/app.db
